# ─────────────────────────────────────────────
# Backend — Environment Configuration Template
# ─────────────────────────────────────────────

ENVIRONMENT=development
API_PORT=8000

# Database Configuration (PostgreSQL)
# Format: postgres://username:password@localhost:5432/database_name?sslmode=disable
DATABASE_URL=postgres://root:@localhost:5432/ejp?sslmode=disable

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Authentication
# Generate a secure key for production
JWT_SECRET=

# Worker Configuration
# Must match the API key set in the worker
WORKER_API_KEY=

# Paths & Settings
BULK_JOBS_PATH=./storage/jobs
DNS_RESOLVERS=8.8.8.8,1.1.1.1
