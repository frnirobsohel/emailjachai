# Backend environment template

# Runtime
GO_ENV=production
ENVIRONMENT=production
PORT=8000

# PostgreSQL
# Example: postgres://user:password@db-host:5432/ejp?sslmode=disable
DATABASE_URL=

# Redis shared with backend and workers.
# Example: redis://:password@redis-host:6379/0
REDIS_URL=

# Secrets
# Use a long random value. Must match the frontend JWT_SECRET.
JWT_SECRET=

# Must match every worker's WORKER_API_KEY.
WORKER_API_KEY=

# Public URLs and CORS
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# Persistent storage paths. Mount a VPS/Coolify volume here.
BULK_RESULTS_PATH=/app/storage/results/bulk
BULK_SOURCE_PATH=/app/storage/jobs/bulk
SINGLE_RESULTS_PATH=/app/storage/results/single

# Optional DNS resolvers for verification.
DNS_RESOLVERS=8.8.8.8,1.1.1.1

# Application timezone for "today" / weekly dashboard stats (IANA name).
# Examples: UTC, Asia/Dhaka. Defaults to UTC when unset.
APP_TIMEZONE=UTC

# Cloudflare Turnstile (public homepage free verifier).
# When TURNSTILE_SECRET_KEY is set, captcha is required.
# TURNSTILE_SITE_KEY is exposed to the frontend via /settings/public.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
