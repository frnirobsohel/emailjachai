<?php
/**
 * EmailJachai Pro - Email Verification Worker Script (Stateless, API-only).
 * This worker uses only HTTP APIs and does not depend on backend PHP includes.
 */

// Register Autoloader
require_once __DIR__ . '/app/Core/Autoloader.php';
\App\Core\Autoloader::register(__DIR__);

use App\Core\Container;
use App\Core\Logger;
use App\Config\Config;
use App\Services\ApiClient;
use App\Services\SmtpVerifier;
use App\Services\DomainCache;
use App\Console\WorkerCommand;

// Boot
Config::loadDotEnv(__DIR__ . '/.env');

$apiAuthority = rtrim((string)Config::getEnvVar('API_URL', 'https://api.yourdomain.com'), '/');
$apiKey = trim((string)Config::getEnvVar('WORKER_API_KEY', ''));
$workerServerPort = max(1, min(65535, (int)Config::getEnvVar('WORKER_SERVER_PORT', '80')));
$workerCount = max(1, (int)Config::getEnvVar('WORKER_COUNT', '1'));
$pushBatchSize = max(1, (int)Config::getEnvVar('WORKER_PUSH_BATCH_SIZE', '50'));
$idleSleepSeconds = max(1, (int)Config::getEnvVar('WORKER_IDLE_SLEEP_SECONDS', '5'));
$maxIdleSleepSeconds = max($idleSleepSeconds, (int)Config::getEnvVar('WORKER_MAX_IDLE_SLEEP_SECONDS', '20'));
$workerServerName = Config::resolveWorkerServerName($workerServerPort);
$environment = Config::getEnvVar('ENVIRONMENT', 'development');

// Fail-fast for production
if ($environment === 'production') {
    if ($apiKey === '' || str_contains($apiKey, 'your-worker-key')) {
        die("Fatal Error: Valid WORKER_API_KEY is required for production.\n");
    }
}

if ($apiKey === '') {
    die("Error: WORKER_API_KEY is not set in environment or .env file.\n");
}
if ($workerServerName === '') {
    die("Error: Unable to derive WORKER_SERVER_NAME. Set WORKER_SERVER_NAME explicitly.\n");
}

// Setup Logger
$logFile = __DIR__ . '/storage/logs/worker.log';
$logger = Container::make(Logger::class, $logFile);

$apiClient = Container::make(ApiClient::class, $apiAuthority, $apiKey, $logger);
$domainCache = Container::make(DomainCache::class, $logger);
$verifier = Container::make(SmtpVerifier::class, $logger, $domainCache);

// Startup connectivity check
$logger->info("Checking API connectivity: $apiAuthority");
try {
    $apiClient->sendHeartbeat($workerServerName, $workerServerPort, $workerCount);
    $logger->info("API connectivity verified.");
} catch (\Throwable $e) {
    if ($environment === 'production') {
        $logger->critical("Could not connect to API at $apiAuthority. Exiting.");
        die("Fatal Error: Check your API_URL and WORKER_API_KEY.\n");
    }
    $logger->warn("API connectivity check failed. Continuing in development mode.");
}

$worker = Container::make(WorkerCommand::class, 
    $apiClient, 
    $verifier, 
    $logger,
    $domainCache,
    $workerServerName, 
    $workerServerPort, 
    $workerCount, 
    $pushBatchSize, 
    $idleSleepSeconds, 
    $maxIdleSleepSeconds
);

$worker->run();
