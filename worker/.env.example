# Worker environment template
#
# Tuning (worker concurrency, chunk size, prepare concurrency) is controlled from
# Admin → Job Control — do NOT set CONCURRENCY / CHUNK_SIZE here.

GO_ENV=production

# Redis shared with the backend.
# Example: redis://:password@redis-host:6379/0
REDIS_URL=

# Internal worker API on the backend.
# Example: https://api.example.com/api/v1/internal
API_BASE_URL=

# Must match the backend WORKER_API_KEY.
WORKER_API_KEY=

# Optional display name in Admin → Servers (defaults to hostname).
WORKER_SERVER_NAME=worker-1
