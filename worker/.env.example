# ─────────────────────────────────────────────
# Worker — Environment Configuration Template
# ─────────────────────────────────────────────

# Redis Configuration (Must match backend)
REDIS_URL=redis://localhost:6379/0

# Worker Settings
CONCURRENCY=10
WORKER_SERVER_NAME=

# API Connection (URL of the backend)
API_URL=http://localhost:8000/api/v1/internal

# Must match the API key set in the backend
WORKER_API_KEY=
