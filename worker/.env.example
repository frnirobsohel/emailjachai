# ─────────────────────────────────────────────
# Worker — Environment Configuration
# ─────────────────────────────────────────────

# URL of your deployed API (must be reachable from this machine)
API_URL=

# Worker authentication key (generate from Admin > Servers panel)
WORKER_API_KEY=

# Identifying info (will auto-detect from hostname, IP, port if empty)
WORKER_SERVER_NAME=
WORKER_SERVER_PORT=
WORKER_IP_ADDRESS=

