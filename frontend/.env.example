# ─────────────────────────────────────────────
# Frontend — Environment Configuration Template
# ─────────────────────────────────────────────

# Application Settings
JWT_SECRET=              # Required for session signing (Next.js server-side)
ENVIRONMENT=development  # 'development' or 'production'
API_DEBUG=true

# API Configuration
# Use absolute URL to your PHP backend (e.g., https://yourdomain.com/api)
API_BASE_URL=http://localhost:8000/api/v1

# Frontend URL (Used for CORS validation)
FRONTEND_URL=http://localhost:3000/

# Admin API Key (Used securely by Next.js Server Actions for public verification)
ADMIN_API_KEY=             # Required for public email verification limit handler
