# Frontend environment template

NODE_ENV=production

# Required for Next.js server-side session cookies.
# Must match the backend JWT_SECRET.
JWT_SECRET=

# Backend API URL reachable from the frontend *server* container.
# Prefer the internal Docker/Dokploy service URL (NOT the public Traefik URL),
# or Traefik may rewrite client IP to 172.17.0.1.
# Example: http://backend:8000/api/v1
API_BASE_URL=

# Debug IP endpoint is hard-disabled when NODE_ENV=production.
# Non-prod only: set to 1 temporarily, open /next-api/debug-ip, then disable.
# DEBUG_CLIENT_IP=1

# Browser WebSocket URL (no ?token= — auth uses Sec-WebSocket-Protocol).
# Example: wss://api.example.com/api/v1/ws
NEXT_PUBLIC_WS_URL=

# Optional error tracking (Sentry). Browser + server use the same project DSN.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Public site origin (canonical). Used for sitemap/robots/OG fallbacks when
# Brand Settings → Site Base URL is empty. Example: https://app.example.com
FRONTEND_URL=https://app.example.com
# Optional alias for the same value:
# NEXT_PUBLIC_SITE_URL=https://app.example.com
