# ─────────────────────────────────────────────
# Frontend — Environment Configuration Template
# ─────────────────────────────────────────────

# Application Settings
JWT_SECRET=              # Required for session signing (Next.js server-side)
ENVIRONMENT=development  # 'development' or 'production'
API_DEBUG=true

# API Configuration
# Absolute URL to the backend API (e.g., https://yourdomain.com/api/v1)
API_BASE_URL=http://localhost:8000/api/v1

# Frontend URL (Used for CORS validation)
FRONTEND_URL=http://localhost:3000/

# NOTE: No ADMIN_API_KEY required. Public email verification uses a dedicated
# backend endpoint (POST /api/v1/jobs/verify-public) with IP-based rate limiting.
