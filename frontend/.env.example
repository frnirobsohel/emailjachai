# ─────────────────────────────────────────────
# Frontend — Environment Configuration Template
# ─────────────────────────────────────────────

# Application Settings
JWT_SECRET=              # Required for session signing (Next.js server-side)
ENVIRONMENT=development  # 'development' or 'production'
API_DEBUG=true

# API Configuration
# Use absolute URL to your PHP backend (e.g., https://yourdomain.com/api)
API_BASE_URL=http://localhost/fontendapi/api

# Frontend URL (Used for CORS validation)
FRONTEND_URL=http://localhost:3000/
