# ============================================================
# EmailJachai-Pro — Root .gitignore
# ============================================================

# ─── Secrets & Environment Files ────────────────────────────
# NEVER commit real .env files with passwords/API keys
.env
.env.local
.env.*.local
!.env.example   # allow example templates
*.pem
*.key
*.cert

# ─── Backend (Go) ───────────────────────────────────────────
backend/.env
backend/main
backend/api
backend/ejp-backend
backend/ejp-backend.exe
backend/tmp/
# Ignore storage contents but preserve folders via .gitkeep
backend/storage/**
!backend/storage/
!backend/storage/.gitkeep
!backend/storage/jobs/
!backend/storage/jobs/.gitkeep
!backend/storage/results/
!backend/storage/results/.gitkeep
!backend/storage/results/single/
!backend/storage/results/single/.gitkeep
backend/backups/
backend/.gocache/
# Go build artifacts
*.exe
*.dll
*.so
*.dylib
*.test
*.out
tmp_*
vendor/
/test_build
/test_worker
# Explicit backend build outputs (belt-and-suspenders)
backend/*.exe
backend/tmp_*
backend/backups/

# ─── Worker (Go) ────────────────────────────────────────────
worker/.env
worker/*.exe
worker/*.out
worker/*~
worker/test_worker
worker/tmp_*
worker/vendor/

# ─── Frontend (Next.js) ─────────────────────────────────────
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/.next/
frontend/out/
frontend/node_modules/
frontend/.turbo/
frontend/build/
# Test cache
frontend/coverage/
*.tsbuildinfo

# ─── IDE & OS ────────────────────────────────────────────────
.vscode/
.idea/
.agents/
.cursor/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ─── Logs & Data ─────────────────────────────────────────────
*.log
logs/
!frontend/app/admin/logs/
!frontend/app/admin/logs/*
*.csv
mock.csv

# ─── Legacy PHP (api/ and worker/ PHP code) ─────────────────
# These are deleted from tracking but kept here in case they return
api/vendor/
api/storage/
api/.env

# ─── Deploy / Installer generated files ──────────────────────
.env
.env.bak.*
deploy/.env
deploy/caddy/data/
deploy/caddy/config/
backups/
